rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Genel Belediye Koleksiyonları (Mobil okur, Yönetim Paneli okur & yazar)
    match /events/{id}                { allow read, write: if true; }
    match /places/{id}                { allow read, write: if true; }
    match /municipal_news/{id}        { allow read, write: if true; }
    match /outages/{id}               { allow read, write: if true; }
    match /pharmacies_on_duty/{id}    { allow read, write: if true; }
    match /weather_info/{id}          { allow read, write: if true; }

    // 2. Şehir Rehberi Koleksiyonları (Kurumsal Hizmetler & Gebze'yi Keşfet)
    match /guide_institutions/{id}    { allow read, write: if true; }
    match /guide_places/{id}          { allow read, write: if true; }

    // 3. E-Belediye ve Gebze Pati Koleksiyonları
    match /ebelediye_categories/{id}  { allow read, write: if true; }
    match /pet_adoptions/{id}         { allow read, write: if true; }
    match /feeding_points/{id}        { allow read, write: if true; }
    match /vet_clinics/{id}           { allow read, write: if true; }

    // 4. Söz Sende - Anketler / Oylamalar
    match /polls/{id}                 { allow read, write: if true; }

    // 5. Söz Sende - Fikir ve Öneriler
    match /suggestions/{id}           { allow read, write: if true; }

    // 6. Çek & Gönder - Vatandaş Bildirimleri / Talepler
    // (Mobil oluşturur ve takip eder, Yönetim Paneli durumu günceller)
    match /reports/{id}               { allow read, write: if true; }

    // 7. Kullanıcı Profili ve Aktiviteler (Mobil & Yönetim Paneli)
    match /users/{id}                 { allow read, write: if true; }
    match /users/{userId}/activities/{activityId} { allow read, write: if true; }
    match /user_activities/{id}       { allow read, write: if true; }

    // Geri kalan her şey kapalı
    match /{document=**}              { allow read, write: if false; }
  }
}