rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // GEBZE BELEDİYESİ DİJİTAL YÖNETİM & MOBİL UYGULAMA KURALLARI
    // --------------------------------------------------

    // 1. Vatandaş Çek & Gönder Talepleri (reports)
    match /reports/{id} {
      allow read, write: if true;
    }

    // 2. Afet ve Acil Durum Toplanma Alanları
    match /assembly_areas/{id} {
      allow read, write: if true;
    }

    // 3. Canlı Bildirim ve Duyuru Yayını
    match /broadcast_notifications/{id} {
      allow read, write: if true;
    }

    match /notifications/{id} {
      allow read, write: if true;
    }

    // 4. Belediye Haberleri ve Duyurular
    match /municipal_news/{id} {
      allow read, write: if true;
    }

    // 5. Etkinlikler ve Kültür
    match /events/{id} {
      allow read, write: if true;
    }

    // 6. Planlı Kesintiler (İSU, SEDAŞ, PALGAZ)
    match /outages/{id} {
      allow read, write: if true;
    }

    // 7. Mahallemde (Saha ve Altyapı Çalışmaları)
    match /neighborhood_works/{id} {
      allow read, write: if true;
    }

    // 8. Nöbetçi Eczaneler
    match /pharmacies_on_duty/{id} {
      allow read, write: if true;
    }

    // 9. Gebze Pati (Sahiplendirme, Odaklar, Klinikler)
    match /pet_adoptions/{id} {
      allow read, write: if true;
    }

    match /feeding_points/{id} {
      allow read, write: if true;
    }

    match /vet_clinics/{id} {
      allow read, write: if true;
    }

    // 10. E-Belediye Kategorileri
    match /ebelediye_categories/{id} {
      allow read, write: if true;
    }

    // 11. Şehir Rehberi ve Mekanlar
    match /places/{id} {
      allow read, write: if true;
    }

    match /guide_institutions/{id} {
      allow read, write: if true;
    }

    match /guide_places/{id} {
      allow read, write: if true;
    }

    match /weather_info/{id} {
      allow read, write: if true;
    }

    // 12. Söz Sende: Anketler ve Oylar
    match /polls/{pollId} {
      allow read, write: if true;
    }

    // 13. Söz Sende: Öneriler
    match /suggestions/{id} {
      allow read, write: if true;
    }

    // 14. Kullanıcı Profilleri ve Alt Koleksiyonları
    match /users/{uid} {
      allow read, write: if true;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if true;
    }

    match /user_activities/{id} {
      allow read, write: if true;
    }

    // 15. Genel Güvenlik Kuralı
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
