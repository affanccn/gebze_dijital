rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Herkes okuyabilir, kimse uygulamadan yazamaz
    match /events/{id}               { allow read: if true; allow write: if false; }
    match /places/{id}               { allow read: if true; allow write: if false; }
    match /municipal_news/{id}       { allow read: if true; allow write: if false; }
    match /outages/{id}              { allow read: if true; allow write: if false; }
    match /pharmacies_on_duty/{id}   { allow read: if true; allow write: if false; }
    match /weather_info/{id}         { allow read: if true; allow write: if false; }
    match /pet_adoptions/{id}        { allow read, write: if true; }
    match /feeding_points/{id}       { allow read, write: if true; }
    match /vet_clinics/{id}          { allow read, write: if true; }

    // Geri kalan her şey kapalı
    match /{document=**} { allow read, write: if false; }
  }
}
